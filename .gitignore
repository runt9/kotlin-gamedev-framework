/.idea
*.iml
# Not root-anchored: with core/, mcp/ and buildSrc/ each producing their own, a leading slash would ignore
# only the root's and commit every module's build output.
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
.agentbridge
out/

# Python bytecode from .claude/reference/_validate.py
__pycache__/
